{
  "name": "concrete-detection-infra-e2e",
  "private": true,
  "description": "Playwright tests for the manual GCP Console steps (service account + key creation)",
  "scripts": {
    "auth": "FORCE_AUTH=1 playwright test --project=setup",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen --channel=chrome --load-storage=.auth/gcp-user.json https://console.cloud.google.com/iam-admin/serviceaccounts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.7.2"
  }
}
