# Copy to .env and fill in.

# Target GCP project ID (required)
GCP_PROJECT_ID=concrete-detection-1-491711

# Service account to create. By default a unique throw-away ID is generated
# (e2e-sa-<random>) and deleted after the run.
# To create the real admin SA from ConcreteDetectionFromScratch.md, set:
#   SA_ID=empowerinnovate-sa
#   SA_DISPLAY_NAME=empowerinnovate-sa
#   CLEANUP=false
# SA_ID=
# SA_DISPLAY_NAME=
# SA_DESCRIPTION=Created by Playwright e2e test

# Delete the service account (and its role bindings) after the run. Default: true
CLEANUP=true

# Cross-check results with the gcloud CLI: auto | true | false
# "auto" uses gcloud only if it is installed and authenticated.
VERIFY_WITH_GCLOUD=auto
