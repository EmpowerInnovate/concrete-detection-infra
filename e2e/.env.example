# Copy to .env and fill in. No passwords or tokens go here: you sign in by hand when asked.

# ---------- GCP project (required) ----------
GCP_PROJECT_ID=concrete-detection-1-491711

# ---------- Admin service account (ConcreteDetectionFromScratch.md steps 2-3) ----------
# Leave SA_ID unset for a throw-away test account (e2e-sa-<random>) that is deleted afterwards.
# For the real account, set:
SA_ID=empowerinnovate-sa
SA_DISPLAY_NAME=empowerinnovate-sa
# SA_DESCRIPTION=Created by Playwright e2e test

# Delete the account after the run. Default: true for a throw-away account, false when SA_ID is set.
# An account that already existed before the run is never deleted.
# CLEANUP=false

# If SA_ID already exists it is used as it is: not created again, never deleted.
# Key: Google can't re-download an old key, so an "old key" is a key file you still have.
# These are used (in this order) if they belong to the account and are still active in the Console:
#   1. SA_KEY_FILE, e.g. a key you downloaded by hand earlier
#   2. output/<SA_ID>-key.json from an earlier run
# Otherwise a new key is created and downloaded.
# SA_KEY_FILE=~/Downloads/concrete-detection-1-491711-abc123.json
# Set to true to always download a new key instead (GCP allows at most 10 keys per account).
# NEW_KEY=false

# Cross-check results with the gcloud CLI: auto | true | false
# "auto" uses gcloud only if it is installed and authenticated.
VERIFY_WITH_GCLOUD=auto

# Run without a visible browser. Default false, so you can sign in when the terminal says ACTION NEEDED.
# HEADLESS=false

# ---------- GitHub pipelines ----------
GITHUB_REPO=EmpowerInnovate/concrete-detection-infra
# Account name shown in the pipeline log: maheshrajannan | empowerinnovate | any other name
GCP_ACCOUNT_NAME=empowerinnovate
# Terraform state bucket (must already exist): crack-detection-terraform | crack-detection-terraform-1 | any other name
GCP_BACKEND_BUCKET=crack-detection-terraform

# ---------- Optional: app service account via "Setup GCP Service Account" (npm run all:app) ----------
# APP_SA_NAME=crack-detection-1
# GCP_REGION=us-central1
# If the app account already exists, the setup pipeline is skipped. Set true to run it anyway.
# FORCE_APP_SA_PIPELINE=false
# A key you already have for the app account (same rules as SA_KEY_FILE)
# APP_SA_KEY_FILE=
# Whose key the cluster pipeline gets when you run `npm run cluster` on its own: admin | app
# (npm run all uses admin, npm run all:app uses app)
# PIPELINE_SA=admin

# ---------- GKE cluster pipeline (npm run all / all:app / cluster) ----------
CLUSTER_NAME=crack-detection-cluster
GCP_CLUSTER_ZONE=us-central1-a
# Wait for the run to finish and fail if it does not succeed (true/false)
# WAIT_FOR_CLUSTER=true
# CLUSTER_TIMEOUT_MIN=45
